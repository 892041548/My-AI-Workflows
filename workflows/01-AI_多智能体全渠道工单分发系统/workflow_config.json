{
  "workflow_schema_version": "2.4.0",
  "name": "AI 多智能体全渠道工单分发系统",
  "id": "wf-ai-9a14625",
  "version": "1.2.0",
  "category": "Enterprise AI Automation & Efficiency",
  "description": "本工作流基于【全渠道多源监听】➔【情绪与优先级研判】➔【知识库召回与拟答】➔【IM 派单与系统建单】闭环拓扑构建。解决人工重复搬运、流程割裂低效等痛点，实现 ⚡ 响应时效缩短 99% · 3秒全链路闭环。",
  "author": "Star4Wish_ZZY",
  "license": "MIT",
  "exportedAt": "2026-09-23T07:00:50.580Z",
  "engine_compatibility": [
    "n8n (v1.30.0+)",
    "Dify (v0.6.0+)",
    "Coze / 扣子平台",
    "FastGPT",
    "Langflow",
    "Python SDK"
  ],
  "environment_variables": {
    "AI_MODEL_PROVIDER": {
      "type": "string",
      "default": "deepseek",
      "description": "大语言模型提供商 (支持 deepseek / openai / moonshot / anthropic)"
    },
    "AI_API_BASE": {
      "type": "string",
      "default": "https://api.deepseek.com/v1",
      "description": "大模型 API 端点 Base URL"
    },
    "AI_API_KEY": {
      "type": "secret",
      "description": "用于驱动中枢智能决策的 API 凭证"
    },
    "WEBHOOK_SECRET_KEY": {
      "type": "secret",
      "description": "入库数据来源签名校验密钥 (HMAC SHA-256)"
    },
    "DELIVERY_WEBHOOK_URL": {
      "type": "string",
      "description": "下游接收通知或数据的 Webhook 地址"
    }
  },
  "runtime_settings": {
    "execution_timeout_seconds": 300,
    "concurrency_limit": 10,
    "retry_strategy": {
      "strategy": "exponential_backoff",
      "max_retries": 3,
      "initial_interval_ms": 1000,
      "backoff_multiplier": 2
    },
    "error_handling": {
      "alert_on_failure": true,
      "alert_channels": [
        "feishu_webhook",
        "email_notify"
      ],
      "fallback_action": "record_error_to_database"
    },
    "logging": {
      "save_input_payload": true,
      "save_output_payload": true,
      "mask_sensitive_headers": true
    }
  },
  "nodes": [
    {
      "id": "node_trigger_01",
      "name": "全渠道多源监听",
      "type": "n8n-nodes-base.webhook",
      "position": [
        180,
        320
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/v1/trigger",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "responseData": "{ \"status\": \"accepted\", \"trace_id\": \"{{ $execution.id }}\" }",
        "options": {
          "rawBody": false,
          "rateLimit": "100 req/min"
        }
      },
      "input_schema": {
        "type": "object",
        "properties": {
          "event_type": {
            "type": "string",
            "description": "事件类型"
          },
          "source_system": {
            "type": "string",
            "description": "数据来源"
          },
          "payload": {
            "type": "object",
            "description": "业务核心入参"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event_type",
          "payload"
        ]
      }
    },
    {
      "id": "node_agent_02",
      "name": "情绪与优先级研判",
      "type": "dify.llm_agent",
      "position": [
        480,
        320
      ],
      "parameters": {
        "provider": "{{ $env.AI_MODEL_PROVIDER }}",
        "model": "deepseek-chat",
        "temperature": 0.6,
        "top_p": 0.95,
        "max_tokens": 4096,
        "system_prompt": "你是一名资深的自动化业务专家与智能决策中枢。\n你的核心职责是：针对传入的【AI 多智能体全渠道工单分发系统】业务数据进行深度语义解析、意图分流与标准化加工。\n【执行原则】\n1. 仔细分析 payload 中的核心诉求与关键参数，提取有效实体；\n2. 依据 SOP 决策标准对任务进行优先级评级（P0/P1/P2）；\n3. 结构化输出下游工具链所需的完整 JSON 数据，严禁臆造虚假字段；\n4. 返回格式必须为标准合法 JSON 结构。",
        "response_format": {
          "type": "json_object"
        },
        "context_memory": {
          "enabled": false,
          "type": "stateless_fast_inference"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "intent": {
            "type": "string",
            "description": "业务意图分类"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "processed_summary": {
            "type": "string",
            "description": "提炼摘要"
          },
          "action_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool_payload": {
            "type": "object",
            "description": "供下游工具调用的结构化数据"
          }
        },
        "required": [
          "intent",
          "tool_payload"
        ]
      }
    },
    {
      "id": "node_tool_03",
      "name": "知识库召回与拟答",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        780,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "{{ $env.DELIVERY_WEBHOOK_URL }}",
        "authentication": "genericCredentialType",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Workflow-Trace",
              "value": "{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"trace_id\": \"{{ $execution.id }}\",\n  \"decision\": {{ $json.node_agent_02.output }},\n  \"status\": \"PROCESSED\"\n}",
        "options": {
          "timeout": 15000,
          "allowUnauthorizedCerts": false,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 1000
          }
        }
      }
    },
    {
      "id": "node_output_04",
      "name": "IM 派单与系统建单",
      "type": "custom.multi_channel_dispatcher",
      "position": [
        1080,
        320
      ],
      "parameters": {
        "channels": [
          {
            "type": "feishu_bot",
            "enabled": true,
            "template": "### ⚡ AI工作流执行成功通知\n- **任务ID**：{{ $execution.id }}\n- **处理结果**：已完成自动分流与归档\n- **耗时**：{{ $execution.elapsedTime }}ms"
          },
          {
            "type": "database_logger",
            "enabled": true,
            "collection": "workflow_audit_logs"
          }
        ]
      }
    }
  ],
  "connections": {
    "node_trigger_01": {
      "main": [
        [
          {
            "node": "node_agent_02",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node_agent_02": {
      "main": [
        [
          {
            "node": "node_tool_03",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "node_tool_03": {
      "main": [
        [
          {
            "node": "node_output_04",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "sample_test_data": {
    "mock_input_payload": {
      "event_type": "WORKFLOW_INGEST",
      "source_system": "Feishu_Bitable",
      "timestamp": "2026-09-23T07:00:50.580Z",
      "payload": {
        "title": "测试任务 - AI 多智能体全渠道工单分发系统",
        "priority": "HIGH",
        "raw_text": "请快速处理该条自动化任务，调用AI中枢进行分发与交付闭环。"
      }
    },
    "expected_output_payload": {
      "status": "SUCCESS",
      "code": 200,
      "trace_id": "sample-trace-9823412",
      "message": "全流程已毫秒级自动化闭环交付",
      "time_saved": "⚡ 响应时效缩短 99% · 3秒全链路闭环"
    }
  },
  "deployment_guide": {
    "quickstart_n8n": [
      "1. 打开 n8n 控制台，进入 Workflows ➔ 点击右上角【...】➔ 选择【Import from File】",
      "2. 选择本 workflow_config.json 文件导入拓扑",
      "3. 在 Credentials 中配置你的 OpenAI / DeepSeek API Key",
      "4. 点击右上角【Active】开关，开启 24 小时无人值守常驻运行"
    ],
    "quickstart_dify": [
      "1. 打开 Dify 面板，点击【工作流 (Workflow)】➔【导入 DSL / 配置文件】",
      "2. 上传本文件，系统会自动识别节点拓扑与系统 Prompt",
      "3. 绑定模型并点击【发布】，即可获得专属 Webhook 触发地址"
    ]
  }
}